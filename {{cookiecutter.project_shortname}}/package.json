{
  "name": "{{ cookiecutter.project_shortname }}",
  "version": "0.0.1",
  "description": "{{ cookiecutter.description }}",
{% if cookiecutter.github_org -%}
  "repository": {
    "type": "git",
    "url": "git://github.com/{{ cookiecutter.github_org }}/{{ cookiecutter.project_shortname.replace('_', '-') }}.git"
  },
  "bugs": {
    "url": "https://github.com/{{ cookiecutter.github_org }}/{{ cookiecutter.project_shortname.replace('_', '-') }}/issues"
  },
  "homepage": "https://github.com/{{ cookiecutter.github_org }}/{{ cookiecutter.project_shortname.replace('_', '-') }}",
{%- endif %}
  "main": "{{ cookiecutter.project_shortname }}/{{ cookiecutter.project_shortname }}.min.js",
  "scripts": {
    "check-node": "node scripts/check-node-version.mjs",
    "preinstall": "node scripts/check-node-version.mjs",
    "prestart": "node scripts/check-node-version.mjs",
    "prebuild:js": "node scripts/check-node-version.mjs",
    "prebuild:python": "node scripts/check-node-version.mjs",
    "start": "vite --host 0.0.0.0 --open",
    "validate-init": "python _validate_init.py",
    "prepublishOnly": "npm run validate-init",
    "build:js": "node scripts/build.mjs",
    "build:python": "node scripts/generate-components.mjs",
    "build:python-activated": "node scripts/generate-components.mjs --venv",
    "build": "npm run build:js && npm run build:python",
    "build:activated": "npm run build:js && npm run build:python-activated",
    "lint": "eslint src --ext .js,.jsx"
  },
  "author": "{{ cookiecutter.author_name }} <{{ cookiecutter.author_email }}>",
  "license": "{% set _license_identifiers = {'MIT License': 'MIT','BSD License': 'BSD','ISC License': 'ISC','Apache Software License 2.0': 'Apache-2.0','GNU General Public License v3': 'GPL-3.0','Not open source': ''} %}{{ _license_identifiers[cookiecutter.license] }}",
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-docgen": "^5.4.3",
    "react-dom": "^18.3.1",
    "vite": "^8.0.13"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  }
}
